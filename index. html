.btn{border:0;border-radius:12px;padding:12px 18px;font-weight:800;cursor:pointer;transition:transform .18s,box-shadow .18s}.btn:hover{transform:translateY(-1px);box-shadow:0 7px 18px rgba(20,40,90,.14)}.primary{background:var(--blue);color:#fff}.yellow{background:var(--yellow);color:#15213b}
