*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text)}
header{background:rgba(7,26,54,.96);backdrop-filter:blur(12px);color:#fff;padding:13px 5%;display:flex;align-items:center;justify-content:space-between;gap:18px;position:sticky;top:0;z-index:50;box-shadow:0 4px 22px rgba(7,26,54,.12)}
