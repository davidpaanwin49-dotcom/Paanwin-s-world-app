.hero-card{background:rgba(255,255,255,.12);box-shadow:0 20px 55px rgba(0,0,0,.18);padding:25px;border:1px solid rgba(255,255,255,.2);border-radius:25px;text-align:center}
.hero-card .emoji{font-size:80px}.hero-card h3{margin:8px}
section{padding:40px 5%;max-width:1250px;margin:auto}.section-title{display:flex;justify-content:space-between;align-items:end;margin-bottom:20px}.section-title h2{margin:0;font-size:27px}.section-title p{margin:5px 0 0;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.mini-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px;max-width:650px}.mini-stat{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.16);border-radius:15px;padding:13px}.mini-stat strong{display:block;font-size:20px}.mini-stat span{font-size:12px;color:#dbe6ff}.card{background:#fff;border-radius:18px;padding:20px;box-shadow:0 5px 22px rgba(20,40,90,.07);border:1px solid #e8edfa;transition:transform .18s,box-shadow .18s}.card:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(20,40,90,.1)}
.cat{color:#fff;min-height:120px;display:flex;flex-direction:column;justify-content:space-between}.cat:nth-child(1){background:#6336d9}.cat:nth-child(2){background:#1479ff}.cat:nth-child(3){background:#18a964}.cat:nth-child(4){background:#f37b18}.cat:nth-child(5){background:#12a8bd}.cat:nth-child(6){background:#ef3c78}.cat:nth-child(7){background:#e6a900}.cat:nth-child(8){background:#4038b8}
.icon{font-size:30px}.cat h3{margin:7px 0 0}.cat small{opacity:.9}
.feature{display:grid;grid-template-columns:1fr 1fr;gap:18px}.kids{background:linear-gradient(135deg,#e8f7ff,#fff2bc)}.products{background:linear-gradient(135deg,#eee8ff,#f9f4ff)}.feature h2{margin:0 0 8px}.feature ul{padding-left:20px;line-height:1.9}
.question-list .q{display:flex;align-items:center;justify-content:space-between;padding:15px 0;border-bottom:1px solid #edf0f7}.q:last-child{border-bottom:0}.q strong{display:block}.q small{color:var(--muted)}
.product{display:flex;flex-direction:column;gap:10px}.product .cover{height:125px;border-radius:12px;background:linear-gradient(135deg,#173e9d,#7446e8);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;text-align:center;padding:10px}.price{font-weight:800;color:#16824f}
.cta{background:linear-gradient(90deg,#126cf0,#6838db);color:#fff;border-radius:22px;padding:28px;display:flex;justify-content:space-between;align-items:center;gap:20px}
footer{background:var(--navy);color:#fff;padding:35px 5%;margin-top:20px}.foot{max-width:1250px;margin:auto;display:flex;justify-content:space-between;gap:25px}.muted{color:#b9c7df;font-size:13px}
