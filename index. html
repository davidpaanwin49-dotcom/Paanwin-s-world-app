]
};

let currentQuiz=[],current=0,score=0,selected=false,currentQuizName='';
function startQuiz(name){
 currentQuiz=quizSets[name];currentQuizName=name;current=0;score=0;selected=false;
 document.getElementById('quizTitle').textContent=name+' Quiz';
 document.getElementById('quizModal').style.display='block';
 document.getElementById('nextBtn').onclick=nextQuestion;
 renderQuestion();
}
function renderQuestion(){
 selected=false;
 const item=currentQuiz[current];
 document.getElementById('quizProgress').textContent='Question '+(current+1)+' of '+currentQuiz.length;
 document.getElementById('quizQuestion').textContent=item[0];
 document.getElementById('quizScore').textContent='Score: '+score;
 document.getElementById('nextBtn').textContent=current===currentQuiz.length-1?'Finish':'Next →';
 const box=document.getElementById('quizOptions');box.innerHTML='';
 item[1].forEach((option,i)=>{
   const b=document.createElement('button');b.className='btn';b.style='display:block;width:100%;text-align:left;margin:9px 0;background:#f2f5fb';
   b.textContent=String.fromCharCode(65+i)+'. '+option;
   b.onclick=()=>chooseAnswer(i,b);
   box.appendChild(b);
 });
}
function chooseAnswer(i,btn){
 if(selected)return;selected=true;
 const correct=currentQuiz[current][2];
 if(i===correct){score++;btn.style.background='#c9f4dd';btn.textContent+='  ✓ Correct';}
 else {btn.style.background='#ffd9df';btn.textContent+='  ✕';}
 document.getElementById('quizScore').textContent='Score: '+score;
}
async function nextQuestion(){
 if(!selected){alert('Choose an answer first.');return;}
 if(current<currentQuiz.length-1){current++;renderQuestion();}
 else{
   document.getElementById('quizQuestion').textContent='🎉 Quiz complete!';
   document.getElementById('quizProgress').textContent='Your result';
   document.getElementById('quizOptions').innerHTML='<div style="font-size:28px;font-weight:800;text-align:center;padding:25px">You scored '+score+' / '+currentQuiz.length+'</div>';
   document.getElementById('nextBtn').textContent='Close';
   document.getElementById('nextBtn').onclick=closeQuiz;
   await recordQuizResult();
 }
}
async function recordQuizResult(){
 try{
   const {data}=await paanwinDB.auth.getSession();
   if(!data.session)return;
   const user=data.session.user;
   const {error}=await paanwinDB.from('student_quiz_results').insert({user_id:user.id,quiz_name:currentQuizName,score:score,total_questions:currentQuiz.length});
   if(error)throw error;
   await loadStudentDashboardStats();
 }catch(err){console.warn('Quiz result was not saved:',err.message);}
}
function closeQuiz(){document.getElementById('quizModal').style.display='none';}
async function saveQuestion(questionId){
 if(!questionId){alert('This question cannot be saved yet.');return;}
 try{
   const {data}=await paanwinDB.auth.getSession();
   if(!data.session){openAuth();return;}
   const {error}=await paanwinDB.from('student_saved_questions').upsert({user_id:data.session.user.id,question_id:questionId});
   if(error)throw error;
   alert('🔖 Question saved to your dashboard.');
   loadStudentDashboardStats();
 }catch(err){alert('Could not save this question yet. '+err.message);}
}
async function buy(name){alert('Checkout for '+name+' will be connected to payment processing in the next stage.');}

async function adminAction(type){
 const names={questions:'Questions',quizzes:'Quizzes',products:'Digital Products',users:'Users'};
 if(type==='questions'){document.getElementById('newQuestion').focus();return;}
 if(type==='users'){
   try{
     const {count,error}=await paanwinDB.from('profiles').select('id',{count:'exact',head:true});
     if(error) throw error;
     document.getElementById('adminUsers').textContent=count||0;
     alert('Registered users: '+(count||0));
   }catch(err){alert('Could not load users: '+err.message);}
   return;
 }
 alert(names[type]+' management is ready for the next database module.');
}
async function addQuestion(){
 const q=document.getElementById('newQuestion').value.trim();
 const a=document.getElementById('newAnswer').value.trim();
 const e=document.getElementById('newExplanation').value.trim();
 const msg=document.getElementById('adminMessage');
 if(!q||!a){msg.style.color='#a52a2a';msg.textContent='Please enter the question and correct answer.';return;}
 msg.style.color='#16824f';msg.textContent='Saving question…';
 try{
   const {data:sessionData}=await paanwinDB.auth.getSession();
   if(!sessionData.session) throw new Error('Please log in as an administrator first.');
   const {data:profile,error:profileError}=await paanwinDB.from('profiles').select('role').eq('id',sessionData.session.user.id).maybeSingle();
   if(profileError) throw profileError;
   if(profile?.role!=='admin') throw new Error('Administrator access is required.');
   const {data,error}=await paanwinDB.from('questions').insert({question:q,answer:a,explanation:e||null,published:true}).select('id,question,answer,explanation').single();
   if(error) throw error;
   questions.unshift({id:data.id,q:data.question,cat:'General',a:data.explanation||'No explanation has been added yet.',correct:data.answer});
   renderQuestions(questions);
   document.getElementById('adminQuestions').textContent=questions.length;
   msg.textContent='✅ Question saved to the live database.';
   document.getElementById('newQuestion').value='';
   document.getElementById('newAnswer').value='';
   document.getElementById('newExplanation').value='';
 }catch(err){msg.style.color='#a52a2a';msg.textContent='❌ '+err.message;}
}

let authMode='login';
function openAuth(){document.getElementById('authModal').style.display='block';}
function closeAuth(){document.getElementById('authModal').style.display='none';}
function toggleAuth(e){
 e.preventDefault(); authMode=authMode==='login'?'signup':'login';
 document.getElementById('authTitle').textContent=authMode==='login'?'Welcome Back':'Create Your Account';
 document.getElementById('authSub').textContent=authMode==='login'?'Login to continue learning.':'Create an account to save progress and quizzes.';
 document.getElementById('authName').style.display=authMode==='signup'?'block':'none';
 document.getElementById('authToggle').textContent=authMode==='login'?'Create an account':'Already have an account? Login';
}
async function submitAuth(){
 const email=document.getElementById('authEmail').value.trim();
 const pass=document.getElementById('authPassword').value;
 const name=document.getElementById('authName').value.trim();
 const role=document.getElementById('authRole').value;
 const msg=document.getElementById('authMessage');
 if(!email||!pass){msg.style.color='#a52a2a';msg.textContent='Please enter your email and password.';return;}
 if(pass.length < 6){msg.style.color='#a52a2a';msg.textContent='Password must be at least 6 characters.';return;}
 msg.style.color='#16824f';
 msg.textContent='Connecting to your account…';
 try{
   if(authMode==='signup'){
     const {data,error}=await paanwinDB.auth.signUp({
       email,
       password:pass,
       options:{data:{full_name:name,role:role}}
     });
     if(error) throw error;
     if(data.session){
       msg.textContent='✅ Account created!';
       setTimeout(()=>{closeAuth();openDashboard(role.toLowerCase().includes('parent')?'parent':'student');},500);
     }else{
       msg.textContent='✅ Account created. Check your email to confirm your account, then log in.';
     }
   }else{
     const {data,error}=await paanwinDB.auth.signInWithPassword({email,password:pass});
     if(error) throw error;
     const savedRole=data.user?.user_metadata?.role || 'Student';
     msg.textContent='✅ Login successful.';
     setTimeout(()=>{closeAuth();openDashboard(savedRole.toLowerCase().includes('parent')?'parent':'student');},400);
   }
 }catch(err){
   console.error('Auth error:',err);
   msg.style.color='#a52a2a';
   msg.textContent='❌ '+(err.message || 'Account action failed.');
 }
}

async function restoreAuth(){
 try{
   const {data}=await paanwinDB.auth.getSession();
   if(data.session){
     const user=data.session.user;
     const btn=document.querySelector('header .btn.yellow');
     if(btn){
       btn.textContent='My Account';
       btn.onclick=()=>openDashboard((user.user_metadata?.role||'Student').toLowerCase().includes('parent')?'parent':'student');
     }
   }
 }catch(err){console.error('Session restore error:',err);}
}

document.addEventListener('DOMContentLoaded',()=>{restoreAuth();loadQuestions();loadAdminAccess();});
function toggleAuthToSignup(){
 if(authMode!=='signup') toggleAuth({preventDefault:()=>{}});
}

async function loadAdminAccess(){
 try{
   const {data}=await paanwinDB.auth.getSession();
   const section=document.getElementById('admin');
   const nav=[...document.querySelectorAll('nav a')].find(a=>a.getAttribute('href')==='#admin');
   if(!data.session){section.style.display='none'; if(nav)nav.style.display='none'; return;}
   const {data:profile}=await paanwinDB.from('profiles').select('role').eq('id',data.session.user.id).maybeSingle();
   const isAdmin=profile?.role==='admin';
   section.style.display=isAdmin?'block':'none';
   if(nav)nav.style.display=isAdmin?'inline':'none';
   if(isAdmin){
     document.getElementById('adminQuestions').textContent=questions.length;
     const {count}=await paanwinDB.from('profiles').select('id',{count:'exact',head:true});
     document.getElementById('adminUsers').textContent=count||0;
   }
 }catch(err){console.warn('Admin access check:',err.message);}
}

async function loadStudentDashboardStats(){
 const title=document.getElementById('dashTitle'), box=document.getElementById('dashContent');
 try{
   const {data:sessionData}=await paanwinDB.auth.getSession();
   const user=sessionData.session?.user;
   if(!user)return;
   const [profileRes,resultsRes,savedRes,progressRes]=await Promise.all([
     paanwinDB.from('profiles').select('full_name,learning_points,badges_count').eq('id',user.id).maybeSingle(),
     paanwinDB.from('student_quiz_results').select('score,total_questions,completed_at,quiz_name').eq('user_id',user.id).order('completed_at',{ascending:false}),
     paanwinDB.from('student_saved_questions').select('question_id',{count:'exact',head:true}).eq('user_id',user.id),
     paanwinDB.from('student_progress').select('question_id,updated_at').eq('user_id',user.id).maybeSingle()
   ]);
   if(profileRes.error)throw profileRes.error;
   if(resultsRes.error)throw resultsRes.error;
   if(savedRes.error)throw savedRes.error;
   if(progressRes.error)throw progressRes.error;
   const results=resultsRes.data||[];
   const completed=results.length;
   const total=results.reduce((sum,r)=>sum+(Number(r.total_questions)||0),0);
   const correct=results.reduce((sum,r)=>sum+(Number(r.score)||0),0);
   const average=total?Math.round(correct/total*100):0;
   const points=profileRes.data?.learning_points ?? correct*10;
   const badges=profileRes.data?.badges_count ?? Math.floor(completed/3);
   const saved=savedRes.count||0;
   const progressText=progressRes.data?.question_id?'Continue from your last studied question.':'Start your first question.';
   title.textContent='🎓 Student Dashboard';
   box.innerHTML='<div class="grid">'+
     '<div class="card"><h3>📚 Continue Learning</h3><p>'+progressText+'</p><button class="btn primary" onclick="closeDashboard();location.href=\'#questions\'">Study Questions</button></div>'+
     '<div class="card"><h3>🧠 Quiz Progress</h3><p>'+completed+' quizzes completed.</p><strong>'+average+'% average</strong></div>'+
     '<div class="card"><h3>🏆 Achievements</h3><p>'+points+' learning points.</p><strong>'+badges+' badges</strong></div>'+
     '<div class="card"><h3>🔖 Saved</h3><p>'+saved+' saved questions.</p><button class="btn primary" onclick="closeDashboard();location.href=\'#questions\'">View Saved</button></div>'+
     '</div>';
 }catch(err){
   console.warn('Dashboard data error:',err.message);
   title.textContent='🎓 Student Dashboard';
   box.innerHTML='<div class="card"><h3>Connecting your dashboard…</h3><p>'+err.message+'</p><button class="btn primary" onclick="loadStudentDashboardStats()">Try Again</button></div>';
 }
}
async function openDashboard(type){
 document.getElementById('dashboardModal').style.display='block';
 const title=document.getElementById('dashTitle'), box=document.getElementById('dashContent');
 if(type==='parent'){
  title.textContent='👨‍👩‍👧 Parent / Guardian Dashboard';
  box.innerHTML='<div class="grid"><div class="card"><h3>📈 Learning Progress</h3><p>Your child\'s learning data will appear here.</p></div><div class="card"><h3>⭐ Achievements</h3><p>Badges and points will appear here.</p></div><div class="card"><h3>🛍️ Purchases</h3><p>Learning product purchases will appear here.</p></div><div class="card"><h3>🔒 Parent Controls</h3><p>Parent controls will be connected next.</p></div></div>';
 } else {
  box.innerHTML='<div class="card"><h3>Loading your real progress…</h3><p>Please wait.</p></div>';
  await loadStudentDashboardStats();
 }
}
function closeDashboard(){document.getElementById('dashboardModal').style.display='none';}
