<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL = "https://borcdhsbviszwpgtzoue.supabase.co";
const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_XhEMJ5Wf0MeOTKCnCnWnOQ_4OP_Y8iw";
const paanwinDB = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);

const demoQuestions=[
 {q:"What is photosynthesis?",cat:"Science",a:"Photosynthesis is the process plants use to make food from light energy, water and carbon dioxide.",correct:"Plants make food using light energy."},
 {q:"What is the capital of Nigeria?",cat:"General Knowledge",a:"Abuja is the capital city of Nigeria.",correct:"Abuja"},
 {q:"How do you calculate percentage?",cat:"Mathematics",a:"Percentage means a part out of 100. For example, 25% of 200 is 50.",correct:"Multiply the number by the percentage divided by 100."},
 {q:"What is HTML?",cat:"Computer",a:"HTML stands for HyperText Markup Language. It is used to structure content on web pages.",correct:"HyperText Markup Language"}
];
let questions=[...demoQuestions];
let categoryMap={};

function renderQuestions(list){
 const bank=document.getElementById('questionBank');
 bank.innerHTML='';
 if(!list.length){bank.innerHTML='<div class="q"><div><strong>No questions found.</strong><small>Try another topic.</small></div></div>';return;}
 list.slice(0,12).forEach((x,i)=>{
  const row=document.createElement('div'); row.className='q'; row.style.cursor='pointer';
  row.innerHTML='<div><strong></strong><small></small></div><span>→</span>';
  row.querySelector('strong').textContent=x.q;
  row.querySelector('small').textContent=x.cat+(x.difficulty?' • '+x.difficulty:'');
  row.onclick=()=>showAnswer(i); bank.appendChild(row);
 });
}

async function showAnswer(i){
 const x=questions[i], box=document.getElementById('answerBox');
 if(!x)return;
 box.style.display='block'; box.innerHTML='';
 const h=document.createElement('h3'); h.textContent='✅ Answer';
 const p1=document.createElement('p'), strong=document.createElement('strong'); strong.textContent=x.correct; p1.appendChild(strong);
 const p2=document.createElement('p'); p2.textContent=x.a;
 const save=document.createElement('button'); save.className='btn primary'; save.style.marginTop='8px'; save.textContent='🔖 Save Question';
 save.onclick=()=>saveQuestion(x.id);
 box.append(h,p1,p2,save);
 box.scrollIntoView({behavior:'smooth',block:'nearest'});
 try{
   const {data}=await paanwinDB.auth.getSession();
   if(data.session && x.id){
     await paanwinDB.from('student_progress').upsert({user_id:data.session.user.id,question_id:x.id,updated_at:new Date().toISOString()});
   }
 }catch(err){console.warn('Progress save skipped:',err.message);}
}

function setDBStatus(connected,message){
 let el=document.getElementById('paanwinDBStatus');
 if(!el){
  el=document.createElement('div'); el.id='paanwinDBStatus';
  el.style.cssText='margin:0 0 14px;font-size:13px;padding:10px 12px;border-radius:10px;background:#fff;';
  document.getElementById('questions').prepend(el);
 }
 el.textContent=connected?'🟢 Connected to Paanwin’s World database — live questions are loaded.':'🔴 Database connection problem: '+(message||'Unknown error');
 el.style.color=connected?'#168a45':'#a52a2a';
}

async function loadQuestions(){
 const bank=document.getElementById('questionBank');
 bank.innerHTML='<div class="q"><div><strong>Loading questions…</strong><small>Connecting to Paanwin’s World database</small></div><span>↻</span></div>';
 try{
  const [qres,cres]=await Promise.all([
   paanwinDB.from('questions').select('id,question,answer,explanation,difficulty,category_id,created_at').eq('published',true).order('created_at',{ascending:false}),
   paanwinDB.from('categories').select('id,name')
  ]);
  if(qres.error) throw qres.error;
  if(cres.error) throw cres.error;
  categoryMap=Object.fromEntries((cres.data||[]).map(c=>[c.id,c.name]));
  questions=(qres.data||[]).map(r=>({id:r.id,q:r.question,cat:categoryMap[r.category_id]||'General',a:r.explanation||'No explanation has been added yet.',correct:r.answer,difficulty:r.difficulty}));
  renderQuestions(questions);
  setDBStatus(true);
 }catch(err){
  console.error('Paanwin database error:',err);
  questions=[...demoQuestions];
  renderQuestions(questions);
  setDBStatus(false,err.message);
 }
}

async function searchQuestion(){
 const term=document.getElementById('searchBox').value.trim();
 if(!term){alert('Type a question or topic first.');return;}
 try{
  let {data,error}=await paanwinDB.from('questions').select('id,question,answer,explanation,difficulty,category_id').eq('published',true).ilike('question','%'+term+'%').limit(30);
  if(error) throw error;
  if(!data || !data.length){
   const second=await paanwinDB.from('questions').select('id,question,answer,explanation,difficulty,category_id').eq('published',true).ilike('answer','%'+term+'%').limit(30);
   if(second.error) throw second.error;
   data=second.data||[];
  }
  questions=(data||[]).map(r=>({id:r.id,q:r.question,cat:categoryMap[r.category_id]||'General',a:r.explanation||'No explanation has been added yet.',correct:r.answer,difficulty:r.difficulty}));
  renderQuestions(questions);
  document.getElementById('questions').scrollIntoView({behavior:'smooth'});
  if(questions.length) showAnswer(0); else alert('No matching question yet.');
 }catch(err){
  console.error('Search error:',err);
  const q=term.toLowerCase();
  const found=demoQuestions.filter(x=>x.q.toLowerCase().includes(q)||x.cat.toLowerCase().includes(q)||x.a.toLowerCase().includes(q));
  questions=found;
  renderQuestions(questions);
  document.getElementById('questions').scrollIntoView({behavior:'smooth'});
  if(questions.length) showAnswer(0); else alert('The database search could not be completed. Please check the connection.');
 }
}

document.addEventListener('DOMContentLoaded',()=>{
 loadQuestions();
 const input=document.getElementById('searchBox');
 if(input) input.addEventListener('keydown',e=>{if(e.key==='Enter')searchQuestion();});
});

const quizSets={
"General Knowledge":[
 ["Which planet is known as the Red Planet?",["Earth","Mars","Jupiter","Venus"],1],
 ["How many days are in a week?",["5","6","7","8"],2],
 ["Which ocean is the largest?",["Atlantic","Indian","Pacific","Arctic"],2]
],
"Mathematics":[
 ["What is 25% of 200?",["25","40","50","75"],2],
 ["What is 9 × 7?",["54","63","72","81"],1],
 ["What is 100 ÷ 4?",["20","25","40","50"],1]
],
"Science":[
 ["Which gas do humans need to breathe?",["Oxygen","Helium","Hydrogen","Neon"],0],
 ["Which organ pumps blood?",["Lung","Brain","Heart","Kidney"],2],
 ["Water freezes at what temperature?",["0°C","10°C","50°C","100°C"],0]
],
"English":[
 ["Which word is a noun?",["Quickly","Beautiful","Teacher","Run"],2],
 ["What is the opposite of 'hot'?",["Warm","Cold","Fast","Dry"],1],
